// TatkalFlow data model.
//
// Portability rules (PGlite in dev/test, PostgreSQL in production):
//  - UUIDs are generated by Prisma (uuid()), not by DB extensions.
//  - Timestamps are timestamptz(3); all instants are stored in UTC.
//  - Only core PostgreSQL types: uuid, text, varchar, int, bool, date,
//    timestamptz, jsonb, enums. No extensions (no citext, pgcrypto, PostGIS).
//  - No partial/expression indexes, triggers or stored procedures.
//
// Security rules:
//  - There is no column for IRCTC passwords, CVV, UPI PIN, bank OTP or any
//    payment authentication credential. Do not add one.
//  - OTPs and refresh tokens are stored only as keyed hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Emit `.js` import specifiers so the compiled output runs on Node ESM.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum OtpSessionStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  TRANSGENDER
}

enum BerthPreference {
  NO_PREFERENCE
  LOWER
  MIDDLE
  UPPER
  SIDE_LOWER
  SIDE_UPPER
}

enum FoodPreference {
  NO_PREFERENCE
  VEG
  NON_VEG
}

enum Quota {
  TATKAL
  PREMIUM_TATKAL
  GENERAL
}

/// Which booking outcomes the user accepts. A preference only.
enum RacWaitlistPreference {
  CONFIRMED_ONLY
  ALLOW_RAC
  ALLOW_WAITLIST
}

/// Booking state machine (brief §38). Transitions are enforced in code.
enum JourneyState {
  DRAFT
  SCHEDULED
  PREPARING
  READY
  TATKAL_OPEN
  USER_ACTION_REQUIRED
  PAYMENT_PENDING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

/// User-facing booking history status (brief §21).
enum BookingStatus {
  SCHEDULED
  PREPARING
  USER_ACTION_REQUIRED
  PAYMENT_PENDING
  BOOKED
  RAC
  WAITLISTED
  FAILED
  CANCELLED
}

enum ScheduledJobKind {
  PREPARATION
  NOTIFY_T_MINUS_24H
  NOTIFY_T_MINUS_15M
  NOTIFY_T_MINUS_5M
  NOTIFY_T_MINUS_1M
  OPENING
}

enum ScheduledJobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Lifecycle: whether a rule version participates in resolution at all.
enum RuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Evidence: whether the value has been checked against an official source.
/// "Rule exists" (ACTIVE) and "rule is verified" (VERIFIED) are separate facts.
enum RuleVerificationStatus {
  UNVERIFIED
  VERIFIED
  EXPIRED
  SUPERSEDED
}

enum StationDatasetStatus {
  ACTIVE
  ARCHIVED
}

enum AuditActorType {
  USER
  SYSTEM
  ADMIN
}

enum UserRole {
  USER
  ADMIN
}

// ───────────────────────── Identity & auth ─────────────────────────

model User {
  id                      String    @id @default(uuid()) @db.Uuid
  /// E.164 (+91XXXXXXXXXX). On account deletion this is replaced with a
  /// tombstone value so the unique constraint stays portable (no partial index).
  mobile                  String    @unique @db.VarChar(32)
  mobileVerifiedAt        DateTime? @map("mobile_verified_at") @db.Timestamptz(3)
  fullName                String?   @map("full_name") @db.VarChar(100)
  email                   String?   @db.VarChar(254)
  preferredLanguage       String    @default("en") @map("preferred_language") @db.VarChar(8)
  timezone                String    @default("Asia/Kolkata") @db.VarChar(64)
  notificationPreferences Json      @default("{\"push\":true,\"email\":false,\"sms\":false}") @map("notification_preferences")
  role                    UserRole  @default(USER)
  lastLoginAt             DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(3)

  authSessions  AuthSession[]
  irctcAccount  IrctcAccount?
  passengers    Passenger[]
  journeys      Journey[]
  journeyTemplates JourneyTemplate[]
  bookings      Booking[]
  pnrRecords    PnrRecord[]
  notifications Notification[]
  auditLogs     AuditLog[]
  stations      UserStation[]

  @@map("users")
}

model OtpSession {
  id             String           @id @default(uuid()) @db.Uuid
  mobile         String           @db.VarChar(32)
  /// HMAC-SHA256(OTP_HASH_PEPPER, sessionId:code). Never the code itself.
  codeHash       String           @map("code_hash") @db.VarChar(128)
  status         OtpSessionStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  attemptCount   Int              @default(0) @map("attempt_count")
  maxAttempts    Int              @map("max_attempts")
  sendCount      Int              @default(1) @map("send_count")
  lastSentAt     DateTime         @map("last_sent_at") @db.Timestamptz(3)
  verifiedAt     DateTime?        @map("verified_at") @db.Timestamptz(3)
  lockedAt       DateTime?        @map("locked_at") @db.Timestamptz(3)
  /// Keyed hash of the requesting IP — used for rate limiting, not tracking.
  requestIpHash  String?          @map("request_ip_hash") @db.VarChar(128)
  provider       String           @db.VarChar(32)
  /// Provider's message reference (not the code).
  providerRef    String?          @map("provider_ref") @db.VarChar(128)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([mobile, createdAt])
  @@index([mobile, lockedAt])
  @@index([requestIpHash, createdAt])
  @@map("otp_sessions")
}

/// One row per refresh token. Rotation creates a new row in the same family;
/// presenting a rotated (revoked) token revokes the whole family.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque refresh token.
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipHash           String?   @map("ip_hash") @db.VarChar(128)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

/// IRCTC account link. V1 stores the user ID only — never a password.
model IrctcAccount {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  irctcUserId            String    @map("irctc_user_id") @db.VarChar(64)
  keepSignedInPreference Boolean   @default(false) @map("keep_signed_in_preference")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("irctc_accounts")
}

// ───────────────────────── Master data ─────────────────────────

model Passenger {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String          @map("user_id") @db.Uuid
  name                 String          @db.VarChar(100)
  age                  Int
  gender               Gender
  berthPreference      BerthPreference @default(NO_PREFERENCE) @map("berth_preference")
  foodPreference       FoodPreference  @default(NO_PREFERENCE) @map("food_preference")
  /// User's wish to claim senior-citizen benefits *if* current rules and the
  /// quota allow it. Eligibility is decided by the rules service, not stored.
  seniorCitizenOptIn   Boolean         @default(false) @map("senior_citizen_opt_in")
  /// For children: whether to book a full berth (where the railway offers the choice).
  childBerthOptIn      Boolean         @default(true) @map("child_berth_opt_in")
  concessionCode       String?         @map("concession_code") @db.VarChar(32)
  nationality          String          @default("IN") @db.VarChar(2)
  lastUsedAt           DateTime?       @map("last_used_at") @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz(3)

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeyPassengers         JourneyPassenger[]
  journeyTemplatePassengers JourneyTemplatePassenger[]

  @@index([userId, deletedAt])
  @@map("passengers")
}

model Station {
  id             String   @id @default(uuid()) @db.Uuid
  /// Official station code, upper-case (e.g. "BCT", "NDLS").
  code           String   @unique @db.VarChar(8)
  name           String   @db.VarChar(120)
  /// Normalised "code name aliases" (lower-case, ASCII) for portable search.
  searchText     String   @map("search_text") @db.VarChar(400)
  /// Alternative/older names, e.g. ["Bombay Central"].
  aliases        Json     @default("[]")
  state          String?  @db.VarChar(64)
  zone           String?  @db.VarChar(16)
  /// Stations removed from a newer dataset are deactivated, never deleted,
  /// so saved journeys and favourites keep resolving.
  isActive       Boolean  @default(true) @map("is_active")
  datasetVersion String   @map("dataset_version") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([searchText])
  @@index([isActive])
  @@map("stations")
}

/// Provenance for each imported station dataset.
model StationDataset {
  id          String               @id @default(uuid()) @db.Uuid
  version     String               @unique @db.VarChar(32)
  source      String               @db.VarChar(500)
  sourceUrl   String?              @map("source_url") @db.VarChar(1000)
  license     String?              @db.VarChar(200)
  recordCount Int                  @map("record_count")
  /// SHA-256 of the normalised records; re-importing identical data is a no-op.
  checksum    String               @db.VarChar(64)
  status      StationDatasetStatus @default(ACTIVE)
  notes       String?              @db.VarChar(2000)
  importedAt  DateTime             @map("imported_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("station_datasets")
}

/// Per-user favourite and recently used stations.
model UserStation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  stationCode String    @map("station_code") @db.VarChar(8)
  isFavourite Boolean   @default(false) @map("is_favourite")
  useCount    Int       @default(0) @map("use_count")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stationCode])
  @@index([userId, lastUsedAt])
  @@map("user_stations")
}

model Train {
  id             String   @id @default(uuid()) @db.Uuid
  number         String   @unique @db.VarChar(8)
  name           String   @db.VarChar(120)
  fromStationCode String? @map("from_station_code") @db.VarChar(8)
  toStationCode  String?  @map("to_station_code") @db.VarChar(8)
  /// Travel classes the train is known to carry, e.g. ["1A","2A","3A"].
  classes        Json     @default("[]")
  isActive       Boolean  @default(true) @map("is_active")
  datasetVersion String   @map("dataset_version") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("trains")
}

// ───────────────────────── Journeys ─────────────────────────

/// A concrete planned journey (an instance). When created from a template,
/// the template's configuration is copied, so later template edits never
/// change it.
model Journey {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  /// Template this journey was created from, if any (provenance only).
  templateId           String?      @map("template_id") @db.Uuid
  /// Null for Phase 3 journeys; the API shows "From → To" instead.
  name                 String?      @db.VarChar(60)
  fromStationCode      String       @map("from_station_code") @db.VarChar(8)
  toStationCode        String       @map("to_station_code") @db.VarChar(8)
  /// Where the passengers board, when not at the origin.
  boardingStationCode  String?      @map("boarding_station_code") @db.VarChar(8)
  /// Calendar date of travel in India (no time component).
  journeyDate          DateTime     @map("journey_date") @db.Date
  quota                Quota        @default(TATKAL)
  state                JourneyState @default(DRAFT)
  anyTrainAllowed      Boolean      @default(false) @map("any_train_allowed")
  useNextAvailableClass Boolean     @default(true) @map("use_next_available_class")
  considerAutoUpgradation Boolean   @default(true) @map("consider_auto_upgradation")
  racWaitlistPreference RacWaitlistPreference @default(ALLOW_WAITLIST) @map("rac_waitlist_preference")
  /// Reserved for future booking preferences. Phase 4 preferences have their
  /// own columns (berth on journey_passengers).
  preferences          Json         @default("{}")
  /// Railway-rule versions in force when the journey was created (Phase 4).
  ruleSnapshot         Json?        @map("rule_snapshot")
  /// Tatkal opening instant computed by the rules engine (UTC).
  tatkalOpensAt        DateTime?    @map("tatkal_opens_at") @db.Timestamptz(3)
  /// Rule versions used for the computation, for auditability.
  tatkalRuleSnapshot   Json?        @map("tatkal_rule_snapshot")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz(3)

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template          JourneyTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  passengers        JourneyPassenger[]
  trainPreferences  JourneyTrainPreference[]
  classPreferences  JourneyClassPreference[]
  schedules         BookingSchedule[]
  bookingSessions   BookingSession[]
  bookings          Booking[]

  @@index([userId, journeyDate])
  @@index([state, tatkalOpensAt])
  @@index([templateId])
  @@map("journeys")
}

model JourneyPassenger {
  id          String   @id @default(uuid()) @db.Uuid
  journeyId   String   @map("journey_id") @db.Uuid
  passengerId String   @map("passenger_id") @db.Uuid
  position    Int
  /// Berth for this journey; copied from the passenger when added.
  berthPreference BerthPreference @default(NO_PREFERENCE) @map("berth_preference")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  journey   Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Restrict)

  @@unique([journeyId, passengerId])
  @@map("journey_passengers")
}

model JourneyTrainPreference {
  id          String   @id @default(uuid()) @db.Uuid
  journeyId   String   @map("journey_id") @db.Uuid
  priority    Int
  trainNumber String   @map("train_number") @db.VarChar(8)
  trainName   String?  @map("train_name") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, priority])
  @@unique([journeyId, trainNumber])
  @@map("journey_train_preferences")
}

model JourneyClassPreference {
  id         String   @id @default(uuid()) @db.Uuid
  journeyId  String   @map("journey_id") @db.Uuid
  priority   Int
  classCode  String   @map("class_code") @db.VarChar(4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, priority])
  @@unique([journeyId, classCode])
  @@map("journey_class_preferences")
}

// ───────────────────────── Journey templates ─────────────────────────

/// A reusable journey configuration (no date). Journeys created from it
/// copy its configuration at creation time.
model JourneyTemplate {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @map("user_id") @db.Uuid
  name                    String                @db.VarChar(60)
  fromStationCode         String                @map("from_station_code") @db.VarChar(8)
  toStationCode           String                @map("to_station_code") @db.VarChar(8)
  boardingStationCode     String?               @map("boarding_station_code") @db.VarChar(8)
  quota                   Quota                 @default(TATKAL)
  anyTrainAllowed         Boolean               @default(false) @map("any_train_allowed")
  useNextAvailableClass   Boolean               @default(true) @map("use_next_available_class")
  considerAutoUpgradation Boolean               @default(true) @map("consider_auto_upgradation")
  racWaitlistPreference   RacWaitlistPreference @default(ALLOW_WAITLIST) @map("rac_waitlist_preference")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?             @map("deleted_at") @db.Timestamptz(3)

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  passengers JourneyTemplatePassenger[]
  trains     JourneyTemplateTrain[]
  classes    JourneyTemplateClass[]
  journeys   Journey[]

  @@index([userId, deletedAt])
  @@map("journey_templates")
}

model JourneyTemplatePassenger {
  id              String          @id @default(uuid()) @db.Uuid
  templateId      String          @map("template_id") @db.Uuid
  passengerId     String          @map("passenger_id") @db.Uuid
  position        Int
  berthPreference BerthPreference @default(NO_PREFERENCE) @map("berth_preference")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  template  JourneyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  passenger Passenger       @relation(fields: [passengerId], references: [id], onDelete: Restrict)

  @@unique([templateId, passengerId])
  @@map("journey_template_passengers")
}

model JourneyTemplateTrain {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  priority    Int
  trainNumber String   @map("train_number") @db.VarChar(8)
  trainName   String?  @map("train_name") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  template JourneyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, priority])
  @@unique([templateId, trainNumber])
  @@map("journey_template_trains")
}

model JourneyTemplateClass {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  priority   Int
  classCode  String   @map("class_code") @db.VarChar(4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  template JourneyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, priority])
  @@unique([templateId, classCode])
  @@map("journey_template_classes")
}

// ───────────────────────── Scheduling & booking ─────────────────────────

/// One row per job the scheduler must run for a journey. `idempotencyKey`
/// (journeyId:kind:runAt) guarantees a job is never enqueued twice.
model BookingSchedule {
  id             String             @id @default(uuid()) @db.Uuid
  journeyId      String             @map("journey_id") @db.Uuid
  kind           ScheduledJobKind
  runAt          DateTime           @map("run_at") @db.Timestamptz(3)
  status         ScheduledJobStatus @default(PENDING)
  idempotencyKey String             @unique @map("idempotency_key") @db.VarChar(160)
  queueJobId     String?            @map("queue_job_id") @db.VarChar(64)
  attemptCount   Int                @default(0) @map("attempt_count")
  lastError      String?            @map("last_error") @db.VarChar(1000)
  completedAt    DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@map("booking_schedules")
}

model BookingSession {
  id             String       @id @default(uuid()) @db.Uuid
  journeyId      String       @map("journey_id") @db.Uuid
  state          JourneyState
  /// Which adapter drove this session: "manual", "mock", later "authorized".
  adapter        String       @db.VarChar(32)
  currentStep    String?      @map("current_step") @db.VarChar(48)
  attemptedClass String?      @map("attempted_class") @db.VarChar(4)
  /// Prevents two booking sessions for the same journey opening.
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(160)
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  journey Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  booking Booking?

  @@index([journeyId])
  @@map("booking_sessions")
}

/// A booking is recorded only when confirmation evidence (a PNR) exists,
/// or to record an explicit failure/cancellation. Never inferred.
model Booking {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  journeyId         String?       @map("journey_id") @db.Uuid
  bookingSessionId  String?       @unique @map("booking_session_id") @db.Uuid
  status            BookingStatus
  pnr               String?       @db.VarChar(10)
  trainNumber       String?       @map("train_number") @db.VarChar(8)
  trainName         String?       @map("train_name") @db.VarChar(120)
  journeyDate       DateTime      @map("journey_date") @db.Date
  fromStationCode   String        @map("from_station_code") @db.VarChar(8)
  toStationCode     String        @map("to_station_code") @db.VarChar(8)
  classCode         String?       @map("class_code") @db.VarChar(4)
  quota             Quota
  /// Snapshot of passenger names/ages/berths at booking time.
  passengerSnapshot Json          @map("passenger_snapshot")
  transactionRef    String?       @map("transaction_ref") @db.VarChar(64)
  /// Fare in paise, to avoid floating point.
  farePaise         Int?          @map("fare_paise")
  bookedAt          DateTime?     @map("booked_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey        Journey?        @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  bookingSession BookingSession? @relation(fields: [bookingSessionId], references: [id], onDelete: SetNull)

  @@index([userId, journeyDate])
  @@index([pnr])
  @@map("bookings")
}

model PnrRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  pnr           String    @db.VarChar(10)
  trainNumber   String?   @map("train_number") @db.VarChar(8)
  journeyDate   DateTime? @map("journey_date") @db.Date
  currentStatus String?   @map("current_status") @db.VarChar(120)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pnr])
  @@map("pnr_records")
}

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  journeyId      String?             @map("journey_id") @db.Uuid
  channel        NotificationChannel
  templateKey    String              @map("template_key") @db.VarChar(64)
  title          String              @db.VarChar(160)
  body           String              @db.VarChar(1000)
  status         NotificationStatus  @default(PENDING)
  idempotencyKey String              @unique @map("idempotency_key") @db.VarChar(160)
  scheduledFor   DateTime?           @map("scheduled_for") @db.Timestamptz(3)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  failureReason  String?             @map("failure_reason") @db.VarChar(500)
  readAt         DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, scheduledFor])
  @@map("notifications")
}

// ───────────────────────── Platform ─────────────────────────

/// Append-only. Metadata is redacted before insert; no updated_at because
/// rows are never modified.
model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  action     String         @db.VarChar(64)
  entityType String?        @map("entity_type") @db.VarChar(48)
  entityId   String?        @map("entity_id") @db.VarChar(64)
  metadata   Json           @default("{}")
  ipHash     String?        @map("ip_hash") @db.VarChar(128)
  userAgent  String?        @map("user_agent") @db.VarChar(512)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Versioned railway rules (brief §12, §36). Values are validated against
/// the typed schemas in @tatkalflow/shared before insert.
model RailwayRule {
  id             String     @id @default(uuid()) @db.Uuid
  ruleKey        String     @map("rule_key") @db.VarChar(64)
  value          Json
  source         String     @db.VarChar(500)
  sourceUrl      String?    @map("source_url") @db.VarChar(1000)
  effectiveFrom  DateTime   @map("effective_from") @db.Timestamptz(3)
  effectiveTo    DateTime?  @map("effective_to") @db.Timestamptz(3)
  lastVerifiedAt DateTime?  @map("last_verified_at") @db.Timestamptz(3)
  verifiedBy     String?    @map("verified_by") @db.VarChar(120)
  verificationStatus RuleVerificationStatus @default(UNVERIFIED) @map("verification_status")
  status         RuleStatus @default(DRAFT)
  notes          String?    @db.VarChar(2000)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([ruleKey, effectiveFrom])
  @@index([ruleKey, status, effectiveFrom])
  @@map("railway_rules")
}

/// Feature flags and operational settings (not railway rules).
model ApplicationSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(64)
  value       Json
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("application_settings")
}
