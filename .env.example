# ─── TatkalFlow API ─────────────────────────────────────────────
# Copy to apps/api/.env for local development. Never commit real secrets.

NODE_ENV=development
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# Local dev: PGlite served by `npm run db:dev` (Postgres wire protocol).
# Production: any PostgreSQL 15+ URL, e.g. postgresql://user:pass@host:5432/tatkalflow?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable
# Keep low (≤5) for PGlite; 10–20 per instance is typical for PostgreSQL.
DATABASE_POOL_MAX=5

# Secrets — each ≥32 chars and all different. Generate with: openssl rand -base64 48
# In production load these from your secret manager, not a file.
JWT_ACCESS_SECRET=
OTP_HASH_PEPPER=
IP_HASH_PEPPER=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP delivery. "mock" is development-only and refused when NODE_ENV=production.
# Production providers (MSG91, Twilio, …) register via registerOtpProvider().
OTP_PROVIDER=mock
# Development only: every mock OTP equals this code, so codes never need to be logged.
MOCK_OTP_FIXED_CODE=123456

OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_SESSION=3
OTP_MAX_REQUESTS_PER_MOBILE_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
OTP_LOCKOUT_THRESHOLD=3
OTP_LOCKOUT_MINUTES=60

# Comma-separated list of web app origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Must be true in production. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
# Set true when running behind a TLS-terminating proxy / load balancer.
TRUST_PROXY=false

# ─── Phase 3 ────────────────────────────────────────────────────
# A just-rotated refresh token replayed within this many seconds from the
# same device fingerprint gets 409 (retry) instead of revoking the session
# family. It never yields tokens. 0 disables it. Max 30.
REFRESH_RACE_GRACE_SECONDS=10
# Refuse to rely on critical railway rules that aren't VERIFIED.
# Default: true in production (cannot be disabled there), false elsewhere.
# RULES_ENFORCE_VERIFICATION=true
RULE_REVERIFY_AFTER_DAYS=90
# HTTP rate-limit store. V1 supports only "memory" (single instance).
RATE_LIMIT_STORE=memory

# ─── Phase 4 ────────────────────────────────────────────────────
# Train data for preferred-train search: "mock" (fictional sample trains, for
# development; refused in production) or "none". Default: mock in development,
# none in production.
# TRAIN_DATA_PROVIDER=mock
